# PostgreSQL
POSTGRES_DB=drusmanova
POSTGRES_USER=drusmanova
POSTGRES_PASSWORD=drusmanova

# Google Calendar (optional — omit for mock mode during dev)
# Generate: base64 -i service-account.json | tr -d '\n'
GOOGLE_CREDENTIALS_JSON=

# Google Calendar ID (use "primary" or the specific calendar ID from Google Calendar settings)
GOOGLE_CALENDAR_ID=primary

# Booking API URL (used by MCP server — for local dev outside Docker)
BOOKING_API_URL=http://localhost:8089
